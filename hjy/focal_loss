def focal_loss_lgb_multiclass(alpha=1.0, gamma=2.0, num_class=3):
    def _focal_loss(preds, train_data):
        y_true = train_data.get_label().astype(int)
        preds = preds.reshape(num_class, -1).T  # (N, C)
        preds = torch.tensor(preds, requires_grad=True)
        y_true = torch.tensor(y_true)

        log_probs = F.log_softmax(preds, dim=1)
        probs = torch.exp(log_probs)
        ce_loss = F.nll_loss(log_probs, y_true, reduction='none')
        focal_factor = (1 - probs.gather(1, y_true.view(-1, 1)).squeeze()) ** gamma
        loss = alpha * focal_factor * ce_loss
        grad = torch.autograd.grad(loss.sum(), preds)[0].numpy().T.reshape(-1)
        hess = np.ones_like(grad)  # approximation
        return grad, hess
    return _focal_loss

